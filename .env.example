# Application
APP_NAME=STT Service
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://stt_user:stt_pass@localhost:5432/stt_db

# Speech-to-text (SCRUM-56)
# local (default) = faster-whisper on CPU, no API key; openai = cloud Whisper; mock = tests only
STT_PROVIDER=local
# LOCAL_WHISPER_MODEL=tiny
# LOCAL_WHISPER_DEVICE=cpu
# LOCAL_WHISPER_COMPUTE_TYPE=int8
# OPENAI_API_KEY=sk-...
# OPENAI_WHISPER_MODEL=whisper-1
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25