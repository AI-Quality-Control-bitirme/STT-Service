# Application
APP_NAME=STT Service
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://stt_user:stt_pass@localhost:5432/stt_db

# Speech-to-text (SCRUM-56)
# mock = local smoke tests without an API key; openai = OpenAI Whisper API
STT_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# OPENAI_WHISPER_MODEL=whisper-1
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25